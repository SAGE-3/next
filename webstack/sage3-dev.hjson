{
  // We are not in production mode
  "production": false,

  // Port to run the server on
  "port": 3000,
  "port_yjs": 3001,
  "port_files": 3002,

  // Name of the server to show in the UI
  "serverName": "Localhost",

  // These can be left alone, they are used to find the assets
  "root": ".",
  "public": "assets",
  "assets": "dist/apps/webapp/assets/",

  // Redis Database Config
  "redis": {
    // The Redis Database URL
    "url": "redis://localhost:6379"
  },

  // Fluentd log configuration
  "fluentd": {
    "server": "localhost",
    "port": 24224,
    "databaseLevel": "partial" // all | partial | none
  },

  // Webserver configuration
  "webserver": {
    "logLevel": "partial", // all | partial | none,
    "uploadLimit": "5GB" // file upload size limit in string, optional units: KB, MB, GB, TB
  },

  // Fastapi python server for kernels
  "kernels": {
    "url": "http://127.0.0.1:8000"
  },
  // Fastapi python server for agents
  "agents": {
    "url": "http://127.0.0.1:9999"
  },
  // VEO VNC container orchestration server
  "veoServer": {
    "url": "https://sage3-vnc.cis230038.projects.jetstream-cloud.org"
  },
  
  // External Services
  "services": {
    "twilio": {
      // Your Account SID from www.twilio.com/console
      "accountSid": "",
      // API Key
      "apiKey": "",
      // API Secret
      "apiSecret": ""
    },
    "livekit": {
      // WebSocket URL clients use to reach the LiveKit server
      "url": "ws://localhost:7880",
      // API Key, must match the LiveKit server config (deployment/configurations/livekit/livekit.yaml)
      "apiKey": "SAGE3KEY",
      // API Secret, must match the LiveKit server config
      "apiSecret": "sage3-livekit-dev-secret-not-for-production"
    },
    "models": {
      "providers": {
        "azure": {
          "apiKey": "",
          "url": "https://uic-east.openai.azure.com",
          "models": {
            "chat": {
              "model_id": "gpt-5.2-chat",
              "capabilities": [
                "chat",
                "code",
                "vision"
              ],
              "max_tokens": 4096,
              "context_window": 128000,
              "api_version": "2025-04-01-preview"
            },
            "text": {
              "model_id": "gpt-5.2",
              "capabilities": [
                "chat"
              ],
              "max_tokens": 4096,
              "context_window": 128000,
              "api_version": "2025-04-01-preview"
            },
            "image": {
              "model_id": "gpt-image-1.5",
              "capabilities": [
                "imagegen"
              ],
              "api_version": "2025-04-01-preview"
            },
            "embedding": {
              "model_id": "text-embedding-3-small",
              "capabilities": [
                "embeddings"
              ],
              "max_tokens": 8191,
              "context_window": 8191,
              "api_version": "2025-04-01-preview"
            }
          }
        },
        "openai": {
          "apiKey": "OPENAI_API_KEY",
          "models": {
            "gpt4": {
              "model_id": "gpt-4-turbo",
              "capabilities": [
                "chat",
                "code",
                "vision"
              ],
              "max_tokens": 4096,
              "context_window": 128000
            }
          }
        },
        "llama4": {
          "url": "https://localhost/",
          "apiKey": "",
          "models": {
            "llama4": {
              "model_id": "llama4",
              "capabilities": [
                "chat",
                "code",
                "vision"
              ],
              "max_tokens": 4096,
              "context_window": 32768
            }
          }
        },
        "gemma4": {
          "url": "https://localhost/",
          "apiKey": "",
          "models": {
            "gemma4": {
              "model_id": "gemma4",
              "capabilities": [
                "chat",
                "code",
                "vision"
              ],
              "max_tokens": 131072,
              "context_window": 131072
            }
          }
        }
      },
      // NeMo Retriever embeddings NIM — set url to where your embed NIM listens
      "embed": {
        "url": "http://localhost:8000",
        "model": "nvidia/llama-nemotron-embed-1b-v2"
      },
      // NeMo Retriever reranking NIM — set url to where your rerank NIM listens
      "rerank": {
        "url": "http://localhost:8001",
        "model": "nvidia/llama-nemotron-rerank-1b-v2"
      },
      // OLM model to convert PDF -> Markdown (key must be "pdf2md"; Seer reads
      // this via LLMManager.ocr_config())
      "pdf2md": {
        "url": "http://localhost:8002",
        "model": "allenai/olmOCR-2-7B-1025-FP8"
      },
      "settings": {
        "default_provider": "azure",
        "timeout_seconds": 60,
        "max_retries": 3,
        "log_requests": true
      }
    }
  },

  // Enable/disable some features for safety
  "features": {
    // Enable Plugins
    "plugins": true,
    // Which Apps to enable
    "apps": [
      "Chat",
      "ChartMaker",
      "Map",
      "Notepad",
      "Poll",
      "SageCell",
      "Stickie",
      "Screenshare",
      "Webview"
    ]
  },

  // Auth Configuration
  "auth": {
    // Secret HASH for the sessions. Change this to something unique.
    "sessionSecret": "SUPERSECRET!!$$",
    // Max age for a session per user. In milliseconds. 8 days
    "sessionMaxAge": 691200000,
    // Which login strategies to enable for the server. Available: guest, jwt, google, cilogon, keycloak, ldap
    // If you enable them ensure you add the relevant config information below.
    "strategies": [
      "guest",
      "jwt",
      "google" // "spectator"  // "cilogon"  // "keycloak"  // "ldap"
    ],
    // A List of emails to enable those users to be admins.
    "admins": [],
    // Guest configuration
    "guestConfig": {
       // Endpoint for the guest login. No need to change this
      "routeEndpoint": "/auth/guest"
    },
    // Spectator configuration
    "spectatorConfig": {
      // Endpoint for the spectator login. No need to change this
      "routeEndpoint": "/auth/spectator"
    },
    // Google configuration
    "googleConfig": {
      // Client ID from the Google Developer Console
      "clientID": "773749598438-sgbn6mj326jj6ggsa8n3avrc3jue0ikv.apps.googleusercontent.com",
      // Client Secret from the Google Developer Console
      "clientSecret": "",
      // Endpoint for the google login
      "routeEndpoint": "/auth/google",
      // Callback URL for the google login
      "callbackURL": "/auth/google/redirect"
    },
    // JWT configuration
    "jwtConfig": {
      // The issuer of the JWT
      "issuer": "sage3app@gmail.com",
      // The audience of the JWT
      "audience": "sage3.app",
      // Public key location. Leave this alone
      "publicKey": "./keys/jwt_public.pem",
      // JWT Route endpoint
      "routeEndpoint": "/auth/jwt"
    },
    // CILogon configuration
    "cilogonConfig": {
      // Client ID from CILogon
      "clientID": "",
      // Client Secret from the CILogon Developer Console
      "clientSecret": "",
      // Endpoint for the cilogon login
      "routeEndpoint": "/auth/cilogon",
      // Callback URL for the cilogon login
      "callbackURL": "/auth/cilogon/redirect"
    },
    // Keycloak (or any OpenID Connect provider) configuration
    // To test locally, run: docker run -p 8080:8080 -e KC_BOOTSTRAP_ADMIN_USERNAME=admin -e KC_BOOTSTRAP_ADMIN_PASSWORD=admin quay.io/keycloak/keycloak:latest start-dev
    // Then create a realm and client at http://localhost:8080, set redirect URI to http://localhost:3000/auth/keycloak/redirect
    "keycloakConfig": {
      // Full Keycloak realm URL — Keycloak will autodiscover all OIDC endpoints from this
      "issuerURL": "http://localhost:8080/realms/sage3",
      // Client ID created in the Keycloak realm
      "clientID": "sage3-local",
      // Client Secret (leave empty for public clients)
      "clientSecret": "",
      // Endpoint to initiate Keycloak login
      "routeEndpoint": "/auth/keycloak",
      // Must match the redirect URI configured in your Keycloak client
      "callbackURL": "/auth/keycloak/redirect"
    },
    // LDAP / Active Directory configuration
    // Add "ldap" to strategies above to enable this.
    // Users authenticate via POST /auth/ldap with { username, password }.
    "ldapConfig": {
      // LDAP server URL.
      // Use ldap:// for plain (port 389) or ldaps:// for TLS (port 636).
      // Active Directory example: "ldap://ad.university.edu:389"
      "url": "ldap://localhost:3890",

      // Service account used to search the directory (bind DN + password).
      // This account only needs read access to the user tree.
      // Active Directory example: "cn=svc-sage3,ou=ServiceAccounts,dc=university,dc=edu"
      "bindDN": "cn=admin,dc=example,dc=com",
      "bindCredentials": "admin",

      // Base DN under which users are searched.
      // Active Directory example: "ou=People,dc=university,dc=edu"
      "searchBase": "ou=users,dc=example,dc=com",

      // LDAP filter used to locate the authenticating user.
      // {{username}} is replaced at login time with the value the user typed.
      // OpenLDAP:        "(uid={{username}})"
      // Active Directory: "(sAMAccountName={{username}})"
      "searchFilter": "(uid={{username}})",

      // Map LDAP group DNs to SAGE3 roles.
      // Roles are checked in priority order: admin > user > spectator.
      // A user's groups are read from the "memberOf" attribute on their entry.
      // Omit a key (or leave it empty) to skip that role mapping.
      // If the user matches no group, defaultRole is assigned instead.
      "groupMapping": {
        "admin": "cn=sage3-admins,ou=groups,dc=example,dc=com",
        "user": "cn=sage3-users,ou=groups,dc=example,dc=com",
        "spectator": "cn=sage3-readonly,ou=groups,dc=example,dc=com"
      },

      // Role assigned when the user authenticates but matches no groupMapping entry.
      // Options: "admin", "user", "spectator"
      "defaultRole": "spectator",

      // TLS options (passed directly to Node.js tls.connect).
      // Only needed if you want to override the default (verify certificates).
      // Set to { "rejectUnauthorized": false } for self-signed certs in dev/test.
      "tlsOptions": {
        "rejectUnauthorized": true
      }
    }
  },

  // Namespace for signing uuid v5 keys
  "namespace": "150e32f0-62b8-11ed-974d-1b79350be347"
}
