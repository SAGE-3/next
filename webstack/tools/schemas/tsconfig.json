{
  "compilerOptions": {
    "target": "es2017",
    "module": "commonjs",
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@sage3/shared": ["../../libs/shared/src/index.ts"],
      "@sage3/shared/types": ["../../libs/shared/src/lib/types/index.ts"]
    }
  }
}
