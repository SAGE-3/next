<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Development hubs run over plain http on the local network (http://localhost:4200) -->
	<!-- The Files panel's Take Photo, which uploads the photo to the room -->
	<key>NSCameraUsageDescription</key>
	<string>Take a photo to add it to the board.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
